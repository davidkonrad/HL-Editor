####### Compile

main.o: main.cpp mainwindow.h \
		tilelist.h \
		unitlist.h \
		buildable.h \
		building.h \
		replace.h \
		Lib.h \
		utils.h \
		fin.h \
		codes.h \
		shp.h \
		units.h \
		other.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o main.cpp

qrc_resources.o: qrc_resources.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o qrc_resources.o qrc_resources.cpp

moc_buildable.o: moc_buildable.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_buildable.o moc_buildable.cpp

moc_building.o: moc_building.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_building.o moc_building.cpp

moc_mainwindow.o: moc_mainwindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_mainwindow.o moc_mainwindow.cpp

moc_replace.o: moc_replace.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_replace.o moc_replace.cpp

moc_tilelist.o: moc_tilelist.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_tilelist.o moc_tilelist.cpp

moc_unitlist.o: moc_unitlist.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_unitlist.o moc_unitlist.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/HL-Editor/bin || mkdir -p $(INSTALL_ROOT)/opt/HL-Editor/bin
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/opt/HL-Editor/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/HL-Editor/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/HL-Editor/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

